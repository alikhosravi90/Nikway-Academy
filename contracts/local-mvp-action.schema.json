{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nikway:local-mvp:action:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_issue": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "requested",
        "ready",
        "executing",
        "verification",
        "accepted",
        "blocked",
        "cancelled",
        "closed"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timeout": {
      "type": "integer",
      "minimum": 1
    },
    "cost_limit": {
      "type": "number",
      "minimum": 0,
      "maximum": 0
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "independent_reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "action_id",
    "parent_issue",
    "objective",
    "owner",
    "correlation_id",
    "status",
    "inputs",
    "outputs",
    "dependencies",
    "tools",
    "permissions",
    "acceptance_criteria",
    "evidence_refs",
    "timeout",
    "cost_limit",
    "attempt_count",
    "independent_reviewer",
    "created_at",
    "updated_at"
  ]
}
