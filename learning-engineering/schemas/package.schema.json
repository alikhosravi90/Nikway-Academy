{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NIKWAY offline exchange profile 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "packageId",
    "packageRevision",
    "producer",
    "objects",
    "dependencyManifest",
    "payloadDigest"
  ],
  "properties": {
    "contractVersion": {
      "const": "0.1.0"
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "packageRevision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "producer": {
      "const": "learning-engineering"
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "urn:nikway:learning-engineering:record:0.1.0"
      },
      "description": "Resolve the record URN from bundled record.schema.json; never fetch it over a network."
    },
    "dependencyManifest": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "payloadDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
