{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^LE-[A-Z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "const": "proposed"
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^LE-[A-Z0-9-]+$"
          },
          "preferredLabel": {
            "type": "object",
            "properties": {
              "fa": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "en": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "fa",
              "en"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "preferredLabel"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "entityKinds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "relationTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "fromKinds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "toKinds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "direction": {
            "const": "subject-to-target"
          },
          "sameKindRequired": {
            "type": "boolean"
          },
          "acyclic": {
            "type": "boolean"
          }
        },
        "required": [
          "type",
          "fromKinds",
          "toKinds",
          "direction",
          "sameKindRequired",
          "acyclic"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "referencePolicy": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "semanticScope": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "const": "proposed"
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewedAt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "reviewer",
        "reviewedAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "version",
    "status",
    "domains",
    "entityKinds",
    "relationTypes",
    "referencePolicy",
    "semanticScope",
    "review"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
