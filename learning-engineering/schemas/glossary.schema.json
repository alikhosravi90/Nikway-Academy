{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^LE-[A-Z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "const": "proposed"
    },
    "definitionAuthorship": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^LE-[A-Z0-9-]+$"
          },
          "preferredLabel": {
            "type": "object",
            "properties": {
              "fa": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "en": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "fa",
              "en"
            ],
            "additionalProperties": false
          },
          "definition": {
            "type": "object",
            "properties": {
              "fa": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "en": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "fa",
              "en"
            ],
            "additionalProperties": false
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "domainIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^LE-[A-Z0-9-]+$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "reviewStatus": {
            "const": "proposed"
          },
          "reviewer": {
            "type": [
              "string",
              "null"
            ]
          },
          "scopeNote": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "preferredLabel",
          "definition",
          "aliases",
          "domainIds",
          "reviewStatus",
          "reviewer",
          "scopeNote"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "id",
    "version",
    "status",
    "definitionAuthorship",
    "entries"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
